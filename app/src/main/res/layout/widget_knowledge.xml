<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp"
    android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_category"
        android:layout_width="match_parent" android:layout_height="24dp"
        android:text="@string/widget_preview_category" android:textColor="#537255"
        android:textSize="12sp" android:singleLine="true" />
    <TextView android:id="@+id/widget_title"
        android:layout_width="match_parent" android:layout_height="52dp"
        android:text="@string/widget_preview_title" android:textColor="#223A2D"
        android:textSize="19sp" android:textStyle="bold" android:maxLines="2"
        android:ellipsize="end" />
    <TextView android:id="@+id/widget_body"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:includeFontPadding="false" android:breakStrategy="simple"
        android:lineSpacingMultiplier="1.15" android:hyphenationFrequency="none"
        android:text="@string/widget_preview_body"
        android:textColor="#36473C" android:textSize="15sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/page_previous" android:layout_width="48dp" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/widget_previous_page" android:textSize="12sp" android:textColor="#537255" />
        <TextView android:id="@+id/widget_page" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="center" android:text="@string/widget_preview_page" android:textSize="11sp" android:textColor="#647365" android:maxLines="1" />
        <TextView android:id="@+id/page_next" android:layout_width="48dp" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/widget_next_page" android:textSize="12sp" android:textColor="#537255" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/tip_previous" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/widget_previous_tip" android:textSize="13sp" android:textColor="#223A2D" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/tip_favorite" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginHorizontal="8dp" android:gravity="center" android:text="@string/widget_favorite" android:textSize="13sp" android:textColor="#223A2D" android:background="@drawable/widget_button" />
        <TextView android:id="@+id/tip_next" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:gravity="center" android:text="@string/widget_next_tip" android:textSize="13sp" android:textColor="#223A2D" android:background="@drawable/widget_button" />
    </LinearLayout>
</LinearLayout>
